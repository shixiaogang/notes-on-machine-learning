# 原样保留第三方字体与配套文件，避免换行转换破坏校验值。
fonts/*.otf -text
fonts/*.ttf -text
fonts/stix2-type1/** -text -whitespace
fonts/licenses/** -text -whitespace

# PDF 为二进制成品；绘图库的 SVG 与带行号原文摘录保持原始导出字节。
*.pdf binary
# 全集超过普通 Git 文件大小限制；LFS 保留 PDF 原始字节。
target/machine-learning-notes.pdf filter=lfs diff=lfs merge=lfs -text
figures/**/*.svg -whitespace
figures/**/source-excerpt.txt -whitespace
# CSV 保留生成器使用的 CRLF，不把行尾 CR 当作数据空格。
figures/**/*.csv whitespace=cr-at-eol
