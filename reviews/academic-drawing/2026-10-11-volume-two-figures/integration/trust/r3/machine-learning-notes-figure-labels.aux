\@writefile{lof}{\contentsline {figure}{\numberline {46.17}{\ignorespaces 四个位置的读取范围。行表示查询位置$i$，列表示键位置$j$，着色格允许读取，带叉白格禁止读取。左为全部有效输入间的双向读取，中为$j\leq i$的因果读取，右为前两个位置构成条件前缀的读取：前缀内部双向，目标读取全部前缀与截至当前位置的目标输入。目标输入已移位，因此读取当前输入不等于读取当前待预测标签。}}{1941}{figure.46.17}\protected@file@percent }
