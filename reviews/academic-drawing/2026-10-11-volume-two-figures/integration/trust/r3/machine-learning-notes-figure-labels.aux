\@writefile{lot}{\contentsline {table}{\numberline {46.4}{\ignorespaces 注意力扩展的主要目标与取舍。比较以相同有效输入、隐藏宽度与预测条件为前提；具体算术和存储量见各方法正文。降低算术量、减少访存、缩小KV缓存和减少内存碎片是不同指标，实际速度还取决于实现与硬件。}}{1952}{table.46.4}\protected@file@percent }
\newlabel{tab:transformer-attention-extensions}{{46.4}{1952}{注意力扩展的主要目标与取舍。比较以相同有效输入、隐藏宽度与预测条件为前提；具体算术和存储量见各方法正文。降低算术量、减少访存、缩小KV缓存和减少内存碎片是不同指标，实际速度还取决于实现与硬件。}{table.46.4}{}}
