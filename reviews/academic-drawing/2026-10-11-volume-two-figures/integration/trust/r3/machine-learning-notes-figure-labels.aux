\@writefile{lof}{\contentsline {figure}{\numberline {25.3}{\ignorespaces 谱范数与激活函数共同控制输入扰动。第$\ell $层线性变换至多放大$s_\ell =\|\bm  {W}_\ell \|_2$倍，层间激活再至多放大$a_\ell $倍；末层为线性输出。右上方两类因子分别连到乘积上界，大括号归并各层作用。当激活均为$1$-Lipschitz时，只剩谱范数乘积；该乘积仍不是完整的泛化复杂度。}}{1163}{figure.25.3}\protected@file@percent }
