\@writefile{lof}{\contentsline {figure}{\numberline {46.2}{\ignorespaces 三个位置的缩放点积注意力，突出显示“追”这一查询。输入分别经三组投影产生查询$\bm  {Q}$、键$\bm  {K}$和值$\bm  {V}$，三者各行依次对应猫、追、狗。突出显示的查询为$q_2=1$，与全部键匹配得到三个得分。Softmax按查询行产生权重矩阵，随后与值矩阵相乘得到各行输出；突出显示的一行权重为$(0.25,0.50,0.25)$，输出为$\bm  {z}_2^{\top }=(0.50,1.25)$。浅色单元格示意矩阵数据，强调色标明同一查询的评分、权重与输出；$d_k=1$、$d_v=2$，数值均为教学设定。}}{1907}{figure.46.2}\protected@file@percent }
\newlabel{fig:transformer-attention}{{46.2}{1907}{三个位置的缩放点积注意力，突出显示“追”这一查询。输入分别经三组投影产生查询$\bm Q$、键$\bm K$和值$\bm V$，三者各行依次对应猫、追、狗。突出显示的查询为$q_2=1$，与全部键匹配得到三个得分。Softmax按查询行产生权重矩阵，随后与值矩阵相乘得到各行输出；突出显示的一行权重为$(0.25,0.50,0.25)$，输出为$\bm z_2^{\top }=(0.50,1.25)$。浅色单元格示意矩阵数据，强调色标明同一查询的评分、权重与输出；$d_k=1$、$d_v=2$，数值均为教学设定。}{figure.46.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {46.2.2.2}自注意力：同一序列内部读取}{1907}{subsubsection.46.2.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {46.3}{\ignorespaces 同一序列“猫／追／狗”上的自注意力。每个词元上方的四格条直接表示输入向量的特征坐标；这同一组表示分别投影为查询、键和值。灰色双向线表示两个位置可以互相读取，自环表示读取自身，两个方向的权重不必相等。红色箭头从值的来源指向“追”的查询位置，对应下方权重矩阵框出的第2行。三个查询各自归一化，图中未另画输出序列；数值为教学设定。}}{1908}{figure.46.3}\protected@file@percent }
\newlabel{fig:transformer-self-attention}{{46.3}{1908}{同一序列“猫／追／狗”上的自注意力。每个词元上方的四格条直接表示输入向量的特征坐标；这同一组表示分别投影为查询、键和值。灰色双向线表示两个位置可以互相读取，自环表示读取自身，两个方向的权重不必相等。红色箭头从值的来源指向“追”的查询位置，对应下方权重矩阵框出的第2行。三个查询各自归一化，图中未另画输出序列；数值为教学设定。}{figure.46.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {46.2.2.3}交叉注意力：从另一组表示读取}{1909}{subsubsection.46.2.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {46.4}{\ignorespaces 两条不同序列的交叉注意力。目标输入BOS／cat的状态投影为两行查询，源输入猫／追／狗的编码状态分别投影为三行键和值。得分与权重矩阵的行对应目标查询、列对应源词元，因此形状均为$2\times 3$；权重矩阵乘以$3\times 2$的值矩阵后，输出为$2\times 2$。较深的单元格突出cat这一目标位置从查询、评分、归一化到输出的对应关系。$d_k=1$，所有投影数值均为教学设定。}}{1910}{figure.46.4}\protected@file@percent }
\newlabel{fig:transformer-cross-attention}{{46.4}{1910}{两条不同序列的交叉注意力。目标输入BOS／cat的状态投影为两行查询，源输入猫／追／狗的编码状态分别投影为三行键和值。得分与权重矩阵的行对应目标查询、列对应源词元，因此形状均为$2\times 3$；权重矩阵乘以$3\times 2$的值矩阵后，输出为$2\times 2$。较深的单元格突出cat这一目标位置从查询、评分、归一化到输出的对应关系。$d_k=1$，所有投影数值均为教学设定。}{figure.46.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {46.2.2.4}因果注意力：只读取已知前缀}{1911}{subsubsection.46.2.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {46.5}{\ignorespaces “猫／追／狗”的因果自注意力。行对应查询位置，列对应被读取的键；红色格为可见位置的示例权重，浅灰叉号表示未来得分被设为$-\infty $、权重为0。“追”这一行经后续网络计算用于预测右侧的“狗”，却不能读取“狗”的输入，因而预测目标与当前输入错开一步；EOS为结束符。下方展开框出的这一行：先屏蔽未来得分，再在可见位置间归一化为$(1/3,2/3,0)$。数值沿用前例，均为教学设定。}}{1911}{figure.46.5}\protected@file@percent }
\newlabel{fig:transformer-causal-attention}{{46.5}{1911}{“猫／追／狗”的因果自注意力。行对应查询位置，列对应被读取的键；红色格为可见位置的示例权重，浅灰叉号表示未来得分被设为$-\infty $、权重为0。“追”这一行经后续网络计算用于预测右侧的“狗”，却不能读取“狗”的输入，因而预测目标与当前输入错开一步；EOS为结束符。下方展开框出的这一行：先屏蔽未来得分，再在可见位置间归一化为$(1/3,2/3,0)$。数值沿用前例，均为教学设定。}{figure.46.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {46.2.2.5}多头注意力：并行形成不同的读取}{1912}{subsubsection.46.2.2.5}\protected@file@percent }
\newlabel{eq:transformer-multihead}{{46.7}{1912}{多头注意力：并行形成不同的读取}{equation.46.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {46.6}{\ignorespaces 同一输入序列上的两个注意力头。每个头分别学习$\bm  {W}_{\mathrm  q,a}$、$\bm  {W}_{\mathrm  k,a}$和$\bm  {W}_{\mathrm  v,a}$，独立完成评分、归一化和加权聚合，得到$\bm  {Z}_a$。标有“沿特征维拼接”的框合并两路结果，两路输出的序列位置一一对齐；它不是残差相加。拼接矩阵$\bm  {C}$再经$\bm  {W}_{\mathrm  o}$投影，得到多头输出$\bm  {Y}$。各头的权重不直接平均，也没有预先指定的语法职责。}}{1913}{figure.46.6}\protected@file@percent }
\newlabel{fig:transformer-multihead}{{46.6}{1913}{同一输入序列上的两个注意力头。每个头分别学习$\bm W_{\mathrm q,a}$、$\bm W_{\mathrm k,a}$和$\bm W_{\mathrm v,a}$，独立完成评分、归一化和加权聚合，得到$\bm Z_a$。标有“沿特征维拼接”的框合并两路结果，两路输出的序列位置一一对齐；它不是残差相加。拼接矩阵$\bm C$再经$\bm W_{\mathrm o}$投影，得到多头输出$\bm Y$。各头的权重不直接平均，也没有预先指定的语法职责。}{figure.46.6}{}}
