\@writefile{lof}{\contentsline {figure}{\numberline {46.20}{\ignorespaces FlashAttention保留稠密注意力结果，改变中间结果的存储与合并方式。左图的常规实现把完整$\bm  {S},\bm  {A}$写回容量较大的HBM；右图按块在HBM与容量较小的片上SRAM间搬运，只在片上保存当前块和在线统计$m,s,\bm  {u}$。在线合并的分母覆盖全部键，输出与同一稠密注意力计算一致。图为存储与计算路径示意，教学数值在正文展开，反向重算细节省略。}}{1947}{figure.46.20}\protected@file@percent }
\newlabel{fig:transformer-flashattention}{{46.20}{1947}{FlashAttention保留稠密注意力结果，改变中间结果的存储与合并方式。左图的常规实现把完整$\bm S,\bm A$写回容量较大的HBM；右图按块在HBM与容量较小的片上SRAM间搬运，只在片上保存当前块和在线统计$m,s,\bm u$。在线合并的分母覆盖全部键，输出与同一稠密注意力计算一致。图为存储与计算路径示意，教学数值在正文展开，反向重算细节省略。}{figure.46.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {46.21}{\ignorespaces 常规实现与FlashAttention的HBM中间量对比。柱高只表示量级差异，不是硬件实测：常规路径显式保存两个$n\times n$矩阵，FlashAttention避免它们完整落地，只保留$\Theta (nd)$规模的序列张量及分块统计。它仍计算稠密位置对，算术量没有因此从平方降为线性；真实I/O还依赖片上容量和块大小。}}{1947}{figure.46.21}\protected@file@percent }
\newlabel{fig:transformer-flashattention-io}{{46.21}{1947}{常规实现与FlashAttention的HBM中间量对比。柱高只表示量级差异，不是硬件实测：常规路径显式保存两个$n\times n$矩阵，FlashAttention避免它们完整落地，只保留$\Theta (nd)$规模的序列张量及分块统计。它仍计算稠密位置对，算术量没有因此从平方降为线性；真实I/O还依赖片上容量和块大小。}{figure.46.21}{}}
