\@writefile{lof}{\contentsline {figure}{\numberline {33.2}{\ignorespaces DP-SGD的一次更新。分别计算批次梯度$\bm  {g}_i$，按$c$取$\operatorname  {clip}_c(\bm  {g}_i)=\bm  {g}_i\min \{1,c/\lVert \bm  {g}_i\rVert _2\}$，随后求和、加入高斯噪声$\bm  {Z}$、除以$b$并更新。账本结合抽样率$q$、噪声尺度$\sigma $、步数$T$等累计消耗，分析必须对应保护单位、邻接关系和抽样约定。向量长度及高斯曲线只示意机制。}}{1353}{figure.33.2}\protected@file@percent }
\newlabel{fig:dp-sgd-update}{{33.2}{1353}{DP-SGD的一次更新。分别计算批次梯度$\bm g_i$，按$c$取$\operatorname {clip}_c(\bm g_i)=\bm g_i\min \{1,c/\lVert \bm g_i\rVert _2\}$，随后求和、加入高斯噪声$\bm Z$、除以$b$并更新。账本结合抽样率$q$、噪声尺度$\sigma $、步数$T$等累计消耗，分析必须对应保护单位、邻接关系和抽样约定。向量长度及高斯曲线只示意机制。}{figure.33.2}{}}
