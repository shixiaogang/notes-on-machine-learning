\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces 三个精确可行损失向量，两个目标均需最小化。$A,B,C$互不支配，但对任意$\alpha \in [0,1]$，$C$的加权损失$0.6$都严格大于$\min \{\alpha ,1-\alpha \}$。绿虚线仅为$\alpha =1/2$时通过$A,B$的等值线，线上其余点不属于这里的可行集合。因此，Pareto最优不保证能由加权和选到。}}{182}{figure.4.8}\protected@file@percent }
\newlabel{fig:opt-pareto-weighted-sum}{{4.8}{182}{三个精确可行损失向量，两个目标均需最小化。$A,B,C$互不支配，但对任意$\alpha \in [0,1]$，$C$的加权损失$0.6$都严格大于$\min \{\alpha ,1-\alpha \}$。绿虚线仅为$\alpha =1/2$时通过$A,B$的等值线，线上其余点不属于这里的可行集合。因此，Pareto最优不保证能由加权和选到。}{figure.4.8}{}}
