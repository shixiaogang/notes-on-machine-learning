\@writefile{lof}{\contentsline {figure}{\numberline {63.2}{\ignorespaces 对角高斯VAE的重参数化与训练。编码器给出均值$\bm  {m}$和正尺度$\bm  {s}$，独立标准正态噪声经$\bm  {z}=\bm  {m}+\bm  {s}\odot \bm  {\epsilon }$形成潜变量，并进入解码器规定的条件分布。重构对数似然的期望与KL项组成ELBO，图中的负ELBO框表示训练目标。生成阶段从先验抽样，不经过编码器；鸟图为概念插画。}}{2339}{figure.63.2}\protected@file@percent }
\newlabel{fig:vae-reparameterization-training}{{63.2}{2339}{对角高斯VAE的重参数化与训练。编码器给出均值$\bm m$和正尺度$\bm s$，独立标准正态噪声经$\bm z=\bm m+\bm s\odot \bm \epsilon $形成潜变量，并进入解码器规定的条件分布。重构对数似然的期望与KL项组成ELBO，图中的负ELBO框表示训练目标。生成阶段从先验抽样，不经过编码器；鸟图为概念插画。}{figure.63.2}{}}
