\@writefile{lof}{\contentsline {figure}{\numberline {9.4}{\ignorespaces 域分类器的错误只对应输入散度项。源输入均匀分布于$[0,1]^2$，目标输入均匀分布于$[\delta ,1+\delta ]\times [0,1]$，其中$0\leq \delta \leq 1$；圆点、方块的位置为教学构造，错误率由区域概率计算。$\mathcal  H$含双向阈值与常值假设，域分类器类取$\mathcal  G=\mathcal  H\triangle \mathcal  H$。其中$g=h_0\mathbin \oplus h_\delta $在左侧浅色带预测源域，$h_a(x)=\mathbb  I\{x_1\geq a\}$；两域均等先验时，最小域错误为$(1-\delta )/2$，$d_{\mathcal  G}=2\delta $。任务风险界还包含源风险及$\lambda =\inf _{h\in \mathcal  H}(R_S(h)+R_T(h))$，不能只由域错误决定。}}{270}{figure.9.4}\protected@file@percent }
\newlabel{fig:learning-domain-classifier}{{9.4}{270}{域分类器的错误只对应输入散度项。源输入均匀分布于$[0,1]^2$，目标输入均匀分布于$[\delta ,1+\delta ]\times [0,1]$，其中$0\leq \delta \leq 1$；圆点、方块的位置为教学构造，错误率由区域概率计算。$\mathcal H$含双向阈值与常值假设，域分类器类取$\mathcal G=\mathcal H\triangle \mathcal H$。其中$g=h_0\mathbin \oplus h_\delta $在左侧浅色带预测源域，$h_a(x)=\mathbb I\{x_1\geq a\}$；两域均等先验时，最小域错误为$(1-\delta )/2$，$d_{\mathcal G}=2\delta $。任务风险界还包含源风险及$\lambda =\inf _{h\in \mathcal H}(R_S(h)+R_T(h))$，不能只由域错误决定。}{figure.9.4}{}}
\newlabel{eq:covariate-risk-identity}{{9.4}{271}{跨域风险的连接与可识别条件}{equation.9.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces 重要性权重重新分配源样本的贡献。在$[0,1]$上构造源密度$p_S(x)=1$、 目标密度$p_T(x)=2x$，二者均积分为1，因此$w(x)=2x$。 五个源样本位置人为取为0.1、0.3、0.5、0.7、0.9，权重依次为0.2、0.6、1、1.4、1.8。 圆点叠在目标密度上，面积与权重成正比，面积不表示局部样本数量。 目标输入必须受到源输入覆盖；要使用风险恒等式，还需保持相同的条件标签分布。}}{271}{figure.9.5}\protected@file@percent }
\newlabel{fig:learning-importance-weighting}{{9.5}{271}{重要性权重重新分配源样本的贡献。在$[0,1]$上构造源密度$p_S(x)=1$、 目标密度$p_T(x)=2x$，二者均积分为1，因此$w(x)=2x$。 五个源样本位置人为取为0.1、0.3、0.5、0.7、0.9，权重依次为0.2、0.6、1、1.4、1.8。 圆点叠在目标密度上，面积与权重成正比，面积不表示局部样本数量。 目标输入必须受到源输入覆盖；要使用风险恒等式，还需保持相同的条件标签分布。}{figure.9.5}{}}
