\@writefile{lof}{\contentsline {figure}{\numberline {10.9}{\ignorespaces 二维LSTM的一步数值走查。蓝色与深灰数字分别表示两个通道；保留分支计算$\bm  {f}\odot \bm  {c}^{(t-1)}$，写入分支计算$\bm  {i}\odot \mathaccent "019B\relax {\bm  {c}}$，二者相加得到新记忆，再经$\bm  {o}\odot \tanh (\bm  {c}^{(t)})$得到隐藏状态。所有数值均由图内向量逐坐标计算，第二通道结果为$0.9\tanh (0.5)\approx 0.416$。图中暂把门值和候选值视为已知，不展开它们的仿射计算。}}{449}{figure.10.9}\protected@file@percent }
\newlabel{fig:rnn-lstm-numerical-step}{{10.9}{449}{二维LSTM的一步数值走查。蓝色与深灰数字分别表示两个通道；保留分支计算$\bm f\odot \bm c^{(t-1)}$，写入分支计算$\bm i\odot \widetilde {\bm c}$，二者相加得到新记忆，再经$\bm o\odot \tanh (\bm c^{(t)})$得到隐藏状态。所有数值均由图内向量逐坐标计算，第二通道结果为$0.9\tanh (0.5)\approx 0.416$。图中暂把门值和候选值视为已知，不展开它们的仿射计算。}{figure.10.9}{}}
