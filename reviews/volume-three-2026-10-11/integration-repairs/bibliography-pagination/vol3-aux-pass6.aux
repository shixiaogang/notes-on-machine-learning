\@writefile{lot}{\contentsline {table}{\numberline {29.1}{\ignorespaces 不同生成机制的查询与采样成本。“精确”表示相应模型的数学计算关系可以直接评价，实际实现仍有浮点误差；连续流和分数ODE另需数值积分，并可能使用随机迹估计。概率电路采用正文的光滑性、可分解性及归一化条件。}}{975}{table.29.1}\protected@file@percent }
\newlabel{tab:pgm-generative-model-comparison}{{29.1}{975}{不同生成机制的查询与采样成本。“精确”表示相应模型的数学计算关系可以直接评价，实际实现仍有浮点误差；连续流和分数ODE另需数值积分，并可能使用随机迹估计。概率电路采用正文的光滑性、可分解性及归一化条件。}{table.29.1}{}}
