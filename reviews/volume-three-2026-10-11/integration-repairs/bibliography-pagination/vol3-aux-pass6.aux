\@writefile{lof}{\contentsline {figure}{\numberline {10.10}{\ignorespaces GRU的状态更新。左侧输入为$\bm  {x}_t$和旧状态$\bm  {h}^{(t-1)}$，右侧输出为新状态。组合输入将当前输入与旧状态一并送入门和候选模块。重置门参与候选计算；顶部两个$\odot $框则显式形成$\bm  {z}^{(t)}\odot \bm  {h}^{(t-1)}$与$(\bm  {1}-\bm  {z}^{(t)})\odot \mathaccent "019B\relax {\bm  {h}}^{(t)}$，再相加得到新状态。任务预测还需在新状态之后另接读出。}}{451}{figure.10.10}\protected@file@percent }
\newlabel{fig:rnn-gru-cell}{{10.10}{451}{GRU的状态更新。左侧输入为$\bm x_t$和旧状态$\bm h^{(t-1)}$，右侧输出为新状态。组合输入将当前输入与旧状态一并送入门和候选模块。重置门参与候选计算；顶部两个$\odot $框则显式形成$\bm z^{(t)}\odot \bm h^{(t-1)}$与$(\bm 1-\bm z^{(t)})\odot \widetilde {\bm h}^{(t)}$，再相加得到新状态。任务预测还需在新状态之后另接读出。}{figure.10.10}{}}
