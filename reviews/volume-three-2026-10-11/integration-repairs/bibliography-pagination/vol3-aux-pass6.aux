\@writefile{lof}{\contentsline {figure}{\numberline {12.3}{\ignorespaces 同一序列“猫／追／狗”上的自注意力。左图将教学输入$\bm  {H}=\bm  {I}_3$分别投影为查询、键和值；中图展示得分及逐行Softmax，行对应查询位置，列对应被读取位置。右图展开第2个查询，将三个二维值按$(0.25,0.50,0.25)$加权，得到$\bm  {z}_2^{\top }=(0.50,1.25)$；下方矩阵汇总各查询分别计算的输出。$d_k=1$、$d_v=2$，所有数值为教学设定。}}{526}{figure.12.3}\protected@file@percent }
\newlabel{fig:transformer-self-attention}{{12.3}{526}{同一序列“猫／追／狗”上的自注意力。左图将教学输入$\bm H=\bm I_3$分别投影为查询、键和值；中图展示得分及逐行Softmax，行对应查询位置，列对应被读取位置。右图展开第2个查询，将三个二维值按$(0.25,0.50,0.25)$加权，得到$\bm z_2^{\top }=(0.50,1.25)$；下方矩阵汇总各查询分别计算的输出。$d_k=1$、$d_v=2$，所有数值为教学设定。}{figure.12.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {12.2.2.3}交叉注意力：从另一组表示读取}{526}{subsubsection.12.2.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12.4}{\ignorespaces 两条不同序列的交叉注意力。目标输入BOS／cat的状态投影为两行查询，源输入猫／追／狗的编码状态分别投影为三行键和值。得分与权重矩阵的行对应目标查询、列对应源词元，因此形状均为$2\times 3$；权重矩阵乘以$3\times 2$的值矩阵后，输出为$2\times 2$。较深的单元格突出cat这一目标位置从查询、评分、归一化到输出的对应关系。$d_k=1$，所有投影数值均为教学设定。}}{528}{figure.12.4}\protected@file@percent }
\newlabel{fig:transformer-cross-attention}{{12.4}{528}{两条不同序列的交叉注意力。目标输入BOS／cat的状态投影为两行查询，源输入猫／追／狗的编码状态分别投影为三行键和值。得分与权重矩阵的行对应目标查询、列对应源词元，因此形状均为$2\times 3$；权重矩阵乘以$3\times 2$的值矩阵后，输出为$2\times 2$。较深的单元格突出cat这一目标位置从查询、评分、归一化到输出的对应关系。$d_k=1$，所有投影数值均为教学设定。}{figure.12.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {12.2.2.4}因果注意力：只读取已知前缀}{529}{subsubsection.12.2.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12.5}{\ignorespaces “猫／追／狗”的因果自注意力。左图的行对应查询位置，列对应被读取的键；着色格给出可见位置的示例权重，浅灰叉号表示未来位置的权重为0。中图展开“追”这一行：原始得分先加因果掩码，再经Softmax得到$(1/3,2/3,0)$。右图加权读取值，得到$(1/3,4/3)^{\top }$，再经后续网络与词表头形成下一词元的预测分布；图中标出该位置的监督目标“狗”。预测“狗”时只读取当前已经给定的“猫／追”。底部展示错开一步的输入与监督目标，EOS为结束符；数值为教学设定。}}{529}{figure.12.5}\protected@file@percent }
\newlabel{fig:transformer-causal-attention}{{12.5}{529}{“猫／追／狗”的因果自注意力。左图的行对应查询位置，列对应被读取的键；着色格给出可见位置的示例权重，浅灰叉号表示未来位置的权重为0。中图展开“追”这一行：原始得分先加因果掩码，再经Softmax得到$(1/3,2/3,0)$。右图加权读取值，得到$(1/3,4/3)^{\top }$，再经后续网络与词表头形成下一词元的预测分布；图中标出该位置的监督目标“狗”。预测“狗”时只读取当前已经给定的“猫／追”。底部展示错开一步的输入与监督目标，EOS为结束符；数值为教学设定。}{figure.12.5}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {12.2.2.5}多头注意力：并行形成不同的读取}{530}{subsubsection.12.2.2.5}\protected@file@percent }
\newlabel{eq:transformer-multihead}{{12.7}{530}{多头注意力：并行形成不同的读取}{equation.12.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.6}{\ignorespaces 同一输入序列上的两个注意力头。每个头分别学习$\bm  {W}_{\mathrm  q,a}$、$\bm  {W}_{\mathrm  k,a}$和$\bm  {W}_{\mathrm  v,a}$，独立完成评分、归一化和加权聚合，得到$\bm  {Z}_a$。标有“沿特征维拼接”的框合并两路结果，两路输出的序列位置一一对齐，合并只增加特征宽度。拼接矩阵$\bm  {C}$再经$\bm  {W}_{\mathrm  o}$投影，得到多头输出$\bm  {Y}$。各头独立形成权重，输出投影组合它们的特征，具体信息分工由训练产生。}}{531}{figure.12.6}\protected@file@percent }
\newlabel{fig:transformer-multihead}{{12.6}{531}{同一输入序列上的两个注意力头。每个头分别学习$\bm W_{\mathrm q,a}$、$\bm W_{\mathrm k,a}$和$\bm W_{\mathrm v,a}$，独立完成评分、归一化和加权聚合，得到$\bm Z_a$。标有“沿特征维拼接”的框合并两路结果，两路输出的序列位置一一对齐，合并只增加特征宽度。拼接矩阵$\bm C$再经$\bm W_{\mathrm o}$投影，得到多头输出$\bm Y$。各头独立形成权重，输出投影组合它们的特征，具体信息分工由训练产生。}{figure.12.6}{}}
