\@writefile{lof}{\contentsline {figure}{\numberline {17.3}{\ignorespaces 四种局部关系及观测中间节点后的路径变化。链和分叉在同一小图中对照两种状态；碰撞关系分为两列，空心$Z$表示未观测的阻断点，红色填充$Z$表示给定后打开的位置。活跃路径允许两端存在依赖，具体参数决定依赖是否出现。在大图中，观测碰撞点的后代也会打开该位置；直接连接没有内部阻断点。}}{676}{figure.17.3}\protected@file@percent }
\newlabel{fig:pgm-directed-motifs}{{17.3}{676}{四种局部关系及观测中间节点后的路径变化。链和分叉在同一小图中对照两种状态；碰撞关系分为两列，空心$Z$表示未观测的阻断点，红色填充$Z$表示给定后打开的位置。活跃路径允许两端存在依赖，具体参数决定依赖是否出现。在大图中，观测碰撞点的后代也会打开该位置；直接连接没有内部阻断点。}{figure.17.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.3.2}d-分离的定义}{677}{subsection.17.3.2}\protected@file@percent }
