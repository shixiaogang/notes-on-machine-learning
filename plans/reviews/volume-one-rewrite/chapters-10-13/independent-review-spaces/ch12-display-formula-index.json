      "C12-P084-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M060",
    "source_line": 884,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E[Y(1)]\n    &=\\mathbb E[TY(1)]+\\mathbb E[(1-T)Y(1)]\\\\\n    &=\\mathbb E[TY]+\\mathbb E[(1-T)Y(1)].\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
