    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M050",
    "source_line": 790,
    "source": "\\begin{equation}\n  \\tau=\\mathbb E_X[\\mu_1(X)-\\mu_0(X)].\n  \\label{eq:causal-ate-adjustment}\n\\end{equation}",
    "paragraph_ids": [
