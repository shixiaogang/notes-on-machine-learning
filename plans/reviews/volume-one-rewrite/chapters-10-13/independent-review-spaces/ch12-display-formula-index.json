  },
  {
    "id": "C12-M049",
    "source_line": 784,
    "source": "\\begin{equation}\n  \\mathbb E[Y(t)]\n  =\\mathbb E_X[\\mathbb E[Y\\mid T=t,X]].\n  \\label{eq:causal-g-formula}\n\\end{equation}",
    "paragraph_ids": [
