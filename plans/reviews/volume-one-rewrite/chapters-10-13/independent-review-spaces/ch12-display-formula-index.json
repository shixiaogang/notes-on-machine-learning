    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M051",
    "source_line": 797,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E\\left[\\frac{TY}{e(X)}\\middle|X\\right]\n    &=\n    \\frac{\\mathbb P(T=1\\mid X)}{e(X)}\n      \\mathbb E[Y\\mid T=1,X]\\\\\n    &=\\mu_1(X).\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P081"
    ],
    "sentence_ids": [
