    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M055",
    "source_line": 827,
    "source": "\\[\n  \\begin{array}{c|cc}\n    &X=0&X=1\\\\ \\hline\n    \\mathbb E[Y(0)\\mid X]&0.1&0.5\\\\\n    \\mathbb E[Y(1)\\mid X]&0.3&0.7\n  \\end{array}\n\\]",
    "paragraph_ids": [
      "C12-P082"
    ],
    "sentence_ids": [
      "C12-P082-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M056",
    "source_line": 835,
    "source": "\\[\n  \\tau=\\tfrac12(0.3-0.1)+\\tfrac12(0.7-0.5)=0.2.\n\\]",
    "paragraph_ids": [
      "C12-P082"
    ],
    "sentence_ids": [
      "C12-P082-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M057",
    "source_line": 839,
    "source": "\\[\n  \\mathbb P(X=1\\mid T=1)=0.8,\\qquad\n  \\mathbb P(X=1\\mid T=0)=0.2.\n\\]",
    "paragraph_ids": [
      "C12-P082"
    ],
    "sentence_ids": [
      "C12-P082-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M058",
    "source_line": 844,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E[Y\\mid T=1]&=0.8\\times0.7+0.2\\times0.3=0.62,\\\\\n    \\mathbb E[Y\\mid T=0]&=0.2\\times0.5+0.8\\times0.1=0.18.\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P082"
    ],
    "sentence_ids": [
      "C12-P082-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M059",
    "source_line": 870,
    "source": "\\begin{equation}\n    \\mathcal I(P_{\\mathrm{obs}})\n    =\\{\\tau(M):M\\in\\mathcal M(P_{\\mathrm{obs}})\\}.\n    \\label{eq:causal-identified-set}\n  \\end{equation}",
    "paragraph_ids": [
