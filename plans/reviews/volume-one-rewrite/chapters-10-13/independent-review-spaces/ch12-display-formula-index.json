    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M052",
    "source_line": 807,
    "source": "\\[\n  \\mathbb E\\left[\\frac{(1-T)Y}{1-e(X)}\\middle|X\\right]\n  =\\mu_0(X).\n\\]",
    "paragraph_ids": [
      "C12-P081"
    ],
    "sentence_ids": [
      "C12-P081-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M053",
    "source_line": 812,
    "source": "\\begin{equation}\n  \\tau=\\mathbb E\\left[\n    \\frac{TY}{e(X)}-\\frac{(1-T)Y}{1-e(X)}\n  \\right].\n  \\label{eq:causal-ipw-identification}\n\\end{equation}",
    "paragraph_ids": [
