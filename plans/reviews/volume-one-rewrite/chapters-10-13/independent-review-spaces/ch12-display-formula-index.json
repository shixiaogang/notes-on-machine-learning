    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M063",
    "source_line": 904,
    "source": "\\begin{equation}\n  \\mathbb E[(1-T)Y]\\leq\\mathbb E[Y(0)]\n  \\leq\\mathbb E[(1-T)Y]+\\mathbb P(T=1).\n  \\label{eq:causal-bounded-outcome-y0}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P085"
    ],
    "sentence_ids": [
      "C12-P085-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M064",
    "source_line": 910,
    "source": "\\begin{equation}\n  \\begin{aligned}\n    &\\mathbb E[TY]-\\mathbb E[(1-T)Y]-\\mathbb P(T=1)\n      \\leq\\tau\\\\\n    &\\qquad\\leq\n      \\mathbb E[TY]+\\mathbb P(T=0)-\\mathbb E[(1-T)Y].\n  \\end{aligned}\n  \\label{eq:causal-manski-ate-bounds}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P085"
    ],
    "sentence_ids": [
      "C12-P085-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M065",
    "source_line": 947,
    "source": "\\[\n  \\tau=\n  \\mathbb E[\\tau(X)\\mathbb I\\{X\\in\\mathcal O\\}]\n  +\\mathbb E[\\tau(X)\\mathbb I\\{X\\in\\mathcal N\\}].\n\\]",
    "paragraph_ids": [
      "C12-P089"
    ],
    "sentence_ids": [
      "C12-P089-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M066",
    "source_line": 953,
    "source": "\\begin{equation}\n  \\begin{aligned}\n    &\\mathbb E[\\tau(X)\\mathbb I\\{X\\in\\mathcal O\\}]\n      -\\mathbb P(X\\in\\mathcal N)\\leq\\tau\\\\\n    &\\qquad\\leq\n      \\mathbb E[\\tau(X)\\mathbb I\\{X\\in\\mathcal O\\}]\n      +\\mathbb P(X\\in\\mathcal N).\n  \\end{aligned}\n  \\label{eq:causal-overlap-gap-bounds}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P089"
    ],
    "sentence_ids": [
      "C12-P089-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M067",
    "source_line": 972,
    "source": "\\[\n  \\pi(a\\mid x)>0\\quad\\Longrightarrow\\quad e_a(x)>0\n\\]",
    "paragraph_ids": [
      "C12-P090"
    ],
    "sentence_ids": [
      "C12-P090-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M068",
    "source_line": 976,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E\\left[\\frac{\\pi(T\\mid X)}{e_T(X)}Y\\middle|X\\right]\n    &=\n    \\sum_{\\substack{a\\in\\mathcal A\\\\e_a(X)>0}}\n      e_a(X)\\frac{\\pi(a\\mid X)}{e_a(X)}\n      \\mathbb E[Y\\mid T=a,X]\\\\\n    &=\n    \\sum_{a\\in\\mathcal A}\\pi(a\\mid X)\\mathbb E[Y(a)\\mid X].\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P090"
    ],
    "sentence_ids": [
      "C12-P090-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M069",
    "source_line": 988,
    "source": "\\begin{equation}\n  V(\\pi)=\\mathbb E\\left[\\frac{\\pi(T\\mid X)}{e_T(X)}Y\\right].\n  \\label{eq:causal-policy-value-weighting}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P090"
    ],
    "sentence_ids": [
      "C12-P090-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M070",
    "source_line": 997,
    "source": "\\[\n  \\begin{aligned}\n    r&=\\mathbb E_X\\left[\\sum_{a:e_a(X)=0}\\pi(a\\mid X)\\right],\\\\\n    K&=\\mathbb E_X\\left[\n      \\sum_{a:e_a(X)>0}\\pi(a\\mid X)\\mathbb E[Y\\mid T=a,X]\n    \\right].\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P091"
    ],
    "sentence_ids": [
      "C12-P091-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M071",
    "source_line": 1006,
    "source": "\\begin{equation}\n  K+Lr\\leq V(\\pi)\\leq K+Hr.\n  \\label{eq:causal-policy-value-bounds}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P091"
    ],
    "sentence_ids": [
      "C12-P091-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M072",
    "source_line": 1014,
    "source": "\\[\n  V(\\pi_1)-V(\\pi_2)\n  =\n  \\mathbb E_X\\sum_a\n    \\bigl(\\pi_1(a\\mid X)-\\pi_2(a\\mid X)\\bigr)\\mathbb E[Y(a)\\mid X]\n\\]",
    "paragraph_ids": [
      "C12-P091"
    ],
    "sentence_ids": [
      "C12-P091-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M073",
    "source_line": 1047,
    "source": "\\[\n  T=\\alpha U+\\varepsilon_T,\\qquad\n  Y=\\beta T+\\gamma U+\\varepsilon_Y,\n\\]",
    "paragraph_ids": [
      "C12-P095"
    ],
    "sentence_ids": [
      "C12-P095-S02"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M074",
    "source_line": 1054,
    "source": "\\begin{equation}\n  \\begin{aligned}\n    \\beta_{\\mathrm{obs}}\n    &=\\frac{\\operatorname{Cov}(T,Y)}{\\operatorname{Var}(T)}\\\\\n    &=\\beta+\n      \\gamma\\frac{\\alpha\\operatorname{Var}(U)}{\\operatorname{Var}(T)}.\n  \\end{aligned}\n  \\label{eq:causal-linear-confounding-bias}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P095"
    ],
    "sentence_ids": [
      "C12-P095-S04"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M075",
    "source_line": 1076,
    "source": "\\[\n  \\begin{aligned}\n    b_1(x)&=\\mathbb E[Y(1)\\mid T=1,X=x]\n            -\\mathbb E[Y(1)\\mid T=0,X=x],\\\\\n    b_0(x)&=\\mathbb E[Y(0)\\mid T=1,X=x]\n            -\\mathbb E[Y(0)\\mid T=0,X=x].\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P096"
    ],
    "sentence_ids": [
      "C12-P096-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M076",
    "source_line": 1090,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E[Y(1)\\mid X=x]\n    &=e(x)\\mu_1(x)+(1-e(x))(\\mu_1(x)-b_1(x))\\\\\n    &=\\mu_1(x)-(1-e(x))b_1(x).\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P097"
    ],
    "sentence_ids": [
      "C12-P097-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M077",
    "source_line": 1098,
    "source": "\\[\n  \\begin{aligned}\n    \\mathbb E[Y(0)\\mid X=x]\n    &=(1-e(x))\\mu_0(x)+e(x)(\\mu_0(x)+b_0(x))\\\\\n    &=\\mu_0(x)+e(x)b_0(x).\n  \\end{aligned}\n\\]",
    "paragraph_ids": [
      "C12-P097"
    ],
    "sentence_ids": [
      "C12-P097-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M078",
    "source_line": 1106,
    "source": "\\begin{equation}\n  \\tau(x)=\\mu_1(x)-\\mu_0(x)\n  -(1-e(x))b_1(x)-e(x)b_0(x).\n  \\label{eq:causal-selection-bias-function}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P097"
    ],
    "sentence_ids": [
      "C12-P097-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M079",
    "source_line": 1113,
    "source": "\\begin{equation}\n  \\begin{aligned}\n    \\mu_1(x)-\\mu_0(x)-\\Delta(x)\n    &\\leq\\tau(x)\\\\\n    &\\leq\\mu_1(x)-\\mu_0(x)+\\Delta(x),\n  \\end{aligned}\n  \\label{eq:causal-sensitivity-bounds}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P097"
    ],
    "sentence_ids": [
      "C12-P097-S01"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M080",
