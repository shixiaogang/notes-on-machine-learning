    ],
    "sentence_ids": [
      "C12-P085-S03"
    ],
    "semantic_record": "chapter-12-sentence-pass.md",
    "role": "mechanical location index; semantic judgment is in the named manual record"
  },
  {
    "id": "C12-M062",
    "source_line": 896,
    "source": "\\begin{equation}\n  \\mathbb E[TY]\\leq\\mathbb E[Y(1)]\n  \\leq\\mathbb E[TY]+\\mathbb P(T=0).\n  \\label{eq:causal-bounded-outcome-y1}\n\\end{equation}",
    "paragraph_ids": [
      "C12-P085"
    ],
    "sentence_ids": [
